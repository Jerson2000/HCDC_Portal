<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all shared preferences containing credentials or authentication tokens -->
        <exclude domain="sharedpref" path="secure_portal_prefs.xml" />
        <exclude domain="sharedpref" path="PortalApp.xml" />
        <exclude domain="sharedpref" path="CookiePersistence.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- MasterKey cannot be transferred across hardware security modules / devices -->
        <exclude domain="sharedpref" path="secure_portal_prefs.xml" />
        <exclude domain="sharedpref" path="PortalApp.xml" />
        <exclude domain="sharedpref" path="CookiePersistence.xml" />
    </device-transfer>
</data-extraction-rules>